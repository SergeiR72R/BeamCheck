<?xml version="1.0" encoding="utf-8"?>
<!-- Autoloader package for AutoCAD-based PERI CAD.
     Install: copy the whole BeamCheck.bundle folder to %APPDATA%\Autodesk\ApplicationPlugins
     and restart. The matching DLL is chosen by AutoCAD version:
       R24.x  (AutoCAD 2021-2024, .NET Framework 4.8) → Contents\Acad\net48
       R25.0+ (AutoCAD 2025+,     .NET 8)              → Contents\Acad\net8 -->
<ApplicationPackage SchemaVersion="1.0" AppVersion="0.2.0" Name="BeamCheck"
                    Description="Нагрузки от стоек строительных лесов на балку (PERI CAD)"
                    Author="BeamCheck"
                    ProductCode="{6E0B6C63-2D7B-4E2C-9C59-2A3A0B6C7A11}"
                    UpgradeCode="{1F7C3B0E-8C0A-4F3E-9E7A-5B2D6C4E8D22}">
  <CompanyDetails Name="BeamCheck" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.0" />
  <Components Description="PERI CAD 24 / AutoCAD 2021-2024">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.0" SeriesMax="R24.3" />
    <ComponentEntry AppName="BeamCheck" Version="0.2.0"
                    ModuleName="./Contents/Acad/net48/BeamCheck.Acad.dll"
                    AppDescription="BEAMLOAD, PERIDUMP, BEAMLOADSETTINGS"
                    LoadOnAutoCADStartup="True" />
  </Components>
  <Components Description="AutoCAD 2025+">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" />
    <ComponentEntry AppName="BeamCheck" Version="0.2.0"
                    ModuleName="./Contents/Acad/net8/BeamCheck.Acad.dll"
                    AppDescription="BEAMLOAD, PERIDUMP, BEAMLOADSETTINGS"
                    LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>
