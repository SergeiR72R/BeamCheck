<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PERI CAD 24 (AutoCAD-based). AutoCAD 2021–2024 share the R24 .NET API on .NET Framework 4.8,
    so building against AutoCAD.NET 24.0 loads in all of them.
    For AutoCAD 2025+ (.NET 8): dotnet build -p:AcadTargetFramework=net8.0-windows -p:AutoCADNetVersion=25.1.0
  -->
  <PropertyGroup>
    <AcadTargetFramework Condition="'$(AcadTargetFramework)' == ''">net48</AcadTargetFramework>
    <TargetFramework>$(AcadTargetFramework)</TargetFramework>
    <AssemblyName>BeamCheck.Acad</AssemblyName>
    <RootNamespace>BeamCheck.Cad</RootNamespace>
    <DefineConstants>$(DefineConstants);ACAD</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)' == ''">24.0.0</AutoCADNetVersion>
    <UseWindowsForms Condition="'$(TargetFramework)' != 'net48'">true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BeamCheck.Cad.Shared\**\*.cs" LinkBase="Shared" />
    <ProjectReference Include="..\BeamCheck.Core\BeamCheck.Core.csproj" />
    <!-- Reference-only: the host application provides these assemblies at runtime. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCADNetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\deploy\BeamCheck.weights.csv" Link="BeamCheck.weights.csv" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\deploy\BeamCheck.weights.csv')" />
    <None Include="..\..\deploy\BeamCheck.settings.json" Link="BeamCheck.settings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\deploy\BeamCheck.settings.json')" />
  </ItemGroup>
</Project>
